# Copy to docker/.env, change the password, and set APP_SECRET.
POSTGRES_USER=rss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rss

# Encrypts stored secrets (2FA, feed passwords) and signs tokens. Generate once with
# `openssl rand -base64 48` and keep it with your backups: changing or losing it voids them.
APP_SECRET=

# Host port the server is published on.
HTTP_PORT=8080
LOG_LEVEL=info
# true logs every TTRSS and Google Reader API call, credentials redacted, to diagnose a client.
#COMPAT_TRACE=false

# The address readers use, e.g. https://reader.example.com, for links in the published feed.
#PUBLIC_URL=
# What the desktop and Android apps call this server when it is added to them, e.g. Home.
#INSTANCE_NAME=

# Set to true (or the proxy's address/CIDR) when running behind a reverse proxy.
# compose.nginx-proxy.yaml defaults it to true.
TRUST_PROXY=false

# nginx-proxy (with compose.nginx-proxy.yaml).
#VIRTUAL_HOST=reader.example.com
#LETSENCRYPT_HOST=reader.example.com
#NGINX_PROXY_NETWORK=nginx-proxy

# Feed defaults; subscriptions can override interval and purge age. FEED_PURGE_DAYS=0 never purges.
FEED_UPDATE_INTERVAL_MINUTES=30
FEED_PURGE_DAYS=180
# Purged entries are kept in a cold-storage archive in the blobs volume (back it up); false deletes them.
#ARCHIVE_ENABLED=true
FEED_DISABLE_AFTER_FAILURES=20

# Feeds on private networks (e.g. a LAN server) are blocked unless allowed here:
# true, or comma-separated CIDRs such as 192.168.1.0/24.
#FETCH_ALLOW_PRIVATE_NETWORKS=

# First admin, created on startup only while the database has no users. Remove after first start.
#ADMIN_LOGIN=admin
#ADMIN_PASSWORD=

# Days of nightly backups to keep (backup profile only).
BACKUP_RETENTION_DAYS=14

# Operations page: days of statistics and of audit events to keep, and requests to one site in an
# hour above which an alert opens.
#OPS_RETENTION_DAYS=90
#AUDIT_RETENTION_DAYS=365
#OPS_HOST_HOURLY_BUDGET=200

# Alert emails; without them alerts stay on the Operations page.
#SMTP_URL=smtps://user:password@mail.example.com:465
#ALERT_EMAIL_TO=you@example.com
#ALERT_EMAIL_FROM=Newses <reader@example.com>

# OpenTelemetry traces, metrics, and logs over OTLP/HTTP; unset is off. With the bundled Grafana
# (docker compose --profile observability up -d), use http://lgtm:4318.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
#OTEL_TRACES_SAMPLER=parentbased_traceidratio
#OTEL_TRACES_SAMPLER_ARG=0.1
#GRAFANA_PORT=3000

# Customize the container prefix names
#COMPOSE_PROJECT_NAME=rss-reader
