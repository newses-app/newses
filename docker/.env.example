# Copy to .env beside compose.yaml (docker/.env in a checkout), change the password, and set
# APP_SECRET.
POSTGRES_USER=rss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rss

# Encrypts stored secrets (2FA, feed passwords) and signs tokens. Generate once with
# `openssl rand -base64 48` and keep it with your backups: changing or losing it voids them.
APP_SECRET=

# Host port the server is published on.
HTTP_PORT=8080
LOG_LEVEL=info
# true logs every TTRSS and Google Reader API call, credentials redacted, to diagnose a client.
#COMPAT_TRACE=false

# The address readers use, e.g. https://reader.example.com, for links in the published feed.
#PUBLIC_URL=
# What the desktop and Android apps call this server, e.g. Home: profiles show as "user @ Home".
#INSTANCE_NAME=
# Where the apps' About tab sends readers for this server's source code. Set it when you run
# changed code (AGPL section 13); the default is the upstream repository at the image's version.
#SOURCE_URL=

# Set to true (or the proxy's address/CIDR) when running behind a reverse proxy.
# compose.nginx-proxy.yaml defaults it to true.
TRUST_PROXY=false

# nginx-proxy (with compose.nginx-proxy.yaml).
#VIRTUAL_HOST=reader.example.com
#LETSENCRYPT_HOST=reader.example.com
#NGINX_PROXY_NETWORK=nginx-proxy

# Feed defaults; subscriptions can override interval and purge age. FEED_PURGE_DAYS=0 never purges.
FEED_UPDATE_INTERVAL_MINUTES=30
FEED_PURGE_DAYS=180
# Purged entries are kept in a cold-storage archive in the blobs volume (back it up); false deletes them.
#ARCHIVE_ENABLED=true
FEED_DISABLE_AFTER_FAILURES=20

# Feeds on private networks (e.g. a LAN server) are blocked unless allowed here:
# true, or comma-separated CIDRs such as 192.168.1.0/24.
#FETCH_ALLOW_PRIVATE_NETWORKS=

# First admin, created on startup only while the database has no users. Remove after first start.
# Choose your own login: admin, root, superuser, and sa are too well known and refused.
#ADMIN_LOGIN=
#ADMIN_PASSWORD=

# A UnifiedPush distributor (ntfy) for the Android app, so the server's pushes reach it with the
# app closed. It needs its own hostname, such as a subdomain of the reader's, routed by your proxy
# to NTFY_PORT (compose.nginx-proxy.yaml routes it). Readers sign in to it from the ntfy app with
# a user you create (see the guide). Add ntfy to COMPOSE_PROFILES, as with backup.
#COMPOSE_PROFILES=ntfy
#NTFY_HOST=ntfy.example.com
#NTFY_PORT=8081
# Only users given access publish to it, not anyone (see the guide for the server's user).
#NTFY_AUTH_ACCESS=*:up*:deny

# ntfy access tokens the server publishes with, host=token pairs, comma-separated: for the
# bundled ntfy with anonymous publishing denied, or another ntfy that needs an account.
#PUSH_TOKENS=ntfy.example.com=tk_…

# Your own downloads of the desktop app for Linux and the Android app, built from a checkout of
# the repository at RELEASE_TAG, the installed version's tag, with docker/compose.apps.yaml (see
# its comments), and served at PUBLIC_URL/downloads/ (https), where they update from.
#RELEASE_TAG=v1.2.3
# linux, android, or both.
#APPS_PLATFORMS=linux,android
# The Android app's signing: your release keystore, base64, and its password, key alias, and key
# password. scripts/android-signing-setup.sh --backup DIR --docker writes them here. Keep the
# keystore and password backed up: an app signed with another key cannot update this one.
# Left empty, no APK is built: set APPS_PLATFORMS=linux.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Days of nightly backups to keep (backup profile only).
BACKUP_RETENTION_DAYS=14

# Operations page: days of statistics and of audit events to keep, and requests to one site in an
# hour above which an alert opens.
#OPS_RETENTION_DAYS=90
#AUDIT_RETENTION_DAYS=365
#OPS_HOST_HOURLY_BUDGET=200

# Alert emails; without them alerts stay on the Operations page.
#SMTP_URL=smtps://user:password@mail.example.com:465
#ALERT_EMAIL_TO=you@example.com
#ALERT_EMAIL_FROM=Newses <reader@example.com>

# OpenTelemetry traces, metrics, and logs over OTLP/HTTP; unset is off. With the bundled Grafana
# (docker compose --profile observability up -d), use http://lgtm:4318.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
#OTEL_TRACES_SAMPLER=parentbased_traceidratio
#OTEL_TRACES_SAMPLER_ARG=0.1
#GRAFANA_PORT=3000

# Customize the container prefix names
#COMPOSE_PROJECT_NAME=rss-reader
