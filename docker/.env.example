# Copy to docker/.env, change the password, and set APP_SECRET.
POSTGRES_USER=rss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rss

# Encrypts stored secrets (2FA, feed passwords) and signs tokens. Generate once with
# `openssl rand -base64 48` and keep it with your backups: changing or losing it voids them.
APP_SECRET=

# Host port the server is published on.
HTTP_PORT=8080
LOG_LEVEL=info

# The address readers use, e.g. https://reader.example.com, for links in the published feed.
#PUBLIC_URL=

# Set to true (or the proxy's address/CIDR) when running behind a reverse proxy.
# compose.nginx-proxy.yaml defaults it to true.
TRUST_PROXY=false

# nginx-proxy (with compose.nginx-proxy.yaml).
#VIRTUAL_HOST=reader.example.com
#LETSENCRYPT_HOST=reader.example.com
#NGINX_PROXY_NETWORK=nginx-proxy

# Feed defaults; subscriptions can override interval and purge age. FEED_PURGE_DAYS=0 never purges.
FEED_UPDATE_INTERVAL_MINUTES=30
FEED_PURGE_DAYS=60
FEED_DISABLE_AFTER_FAILURES=20

# Feeds on private networks (e.g. a LAN server) are blocked unless allowed here:
# true, or comma-separated CIDRs such as 192.168.1.0/24.
#FETCH_ALLOW_PRIVATE_NETWORKS=

# First admin, created on startup only while the database has no users. Remove after first start.
#ADMIN_LOGIN=admin
#ADMIN_PASSWORD=

# Days of nightly backups to keep (backup profile only).
BACKUP_RETENTION_DAYS=14
