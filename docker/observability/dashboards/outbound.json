{
  "uid": "rss-reader-outbound",
  "title": "rss-reader: Remote hosts",
  "description": "Load on the sites the reader fetches from. Per-host detail is on the Operations page.",
  "tags": ["rss-reader"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "rss-reader",
      "type": "dashboards",
      "tags": ["rss-reader"],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rss_fetch_outcome) (rate(rss_outbound_requests_total{job=~\"rss-reader-.*\"}[$__rate_interval]))",
          "legendFormat": "{{rss_fetch_outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by purpose",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rss_fetch_purpose) (rate(rss_outbound_requests_total{job=~\"rss-reader-.*\"}[$__rate_interval]))",
          "legendFormat": "{{rss_fetch_purpose}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate limited (429, 503 with Retry-After)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rss_fetch_purpose) (increase(rss_outbound_requests_total{job=~\"rss-reader-.*\",rss_fetch_outcome=\"rate_limited\"}[$__rate_interval]))",
          "legendFormat": "{{rss_fetch_purpose}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Not modified share",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rss_outbound_requests_total{job=~\"rss-reader-.*\",rss_fetch_outcome=\"not_modified\"}[$__rate_interval])) / sum(rate(rss_outbound_requests_total{job=~\"rss-reader-.*\",rss_fetch_purpose=\"feed\"}[$__rate_interval]))",
          "legendFormat": "feeds answered 304",
          "refId": "A"
        }
      ],
      "description": "Share of feed fetches the conditional GET saved."
    },
    {
      "type": "timeseries",
      "title": "Duration p95 by purpose",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, rss_fetch_purpose) (rate(rss_outbound_duration_seconds_bucket{job=~\"rss-reader-.*\"}[$__rate_interval])))",
          "legendFormat": "{{rss_fetch_purpose}}",
          "refId": "A"
        }
      ]
    }
  ]
}
